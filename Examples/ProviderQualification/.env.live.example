# Copy to .env.live only on the operator machine. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESOLVED_MODEL=
OPENAI_BASE_URL=https://api.openai.com

ANTHROPIC_API_KEY=
SWIFT_AGENT_ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_RESOLVED_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional OpenAI-compatible gateway profile. Select with --service gateway.
CHAINBOW_API_KEY=
CHAINBOW_MODEL=
CHAINBOW_RESOLVED_MODEL=
CHAINBOW_BASE_URL=

# Reuse one ledger across CLI and UI live runs.
SWIFT_AGENT_LIVE_BUDGET_FILE=
