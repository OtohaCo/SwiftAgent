# Copy to .env.live only on the operator machine. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESOLVED_MODEL=
OPENAI_BASE_URL=https://api.openai.com

ANTHROPIC_API_KEY=
SWIFT_AGENT_ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_RESOLVED_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local/self-hosted OpenAI-compatible Responses endpoint. Authentication is
# optional. The base URL must stop before /responses.
SWIFTAGENT_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
SWIFTAGENT_LOCAL_MODEL=
SWIFTAGENT_LOCAL_API_KEY=

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional OpenAI-compatible gateway profile. Select with --service gateway.
SUB2API_API_KEY=
SUB2API_MODEL=
SUB2API_RESOLVED_MODEL=
SUB2API_BASE_URL=

# Reuse one ledger across CLI and UI live runs.
SWIFT_AGENT_LIVE_BUDGET_FILE=
# Optional positive integer overrides. Defaults remain 12 per provider and 48
# total when omitted. The total must be at least the per-provider limit.
SWIFT_AGENT_LIVE_PER_PROVIDER_LIMIT=
SWIFT_AGENT_LIVE_TOTAL_LIMIT=
